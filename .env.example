DJANGO_DEBUG=false
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=false

CSAGE_AUTH_USERNAME=csageadmin
CSAGE_AUTH_PASSWORD=change-me
CSAGE_DISABLE_AUTH=false
CSAGE_DATA_DIR=/data
CSAGE_ACCOUNTS_FILE=/data/accounts.json
CSAGE_LIFECYCLE_FILE=/data/lifecycle_rules.json
CSAGE_SUPPRESSION_FILE=/data/suppressed_findings.json
CSAGE_SCAN_HISTORY_LIMIT=50

AWS_DEFAULT_REGION=ap-south-1

CSAGE_MAX_WORKERS=8
CSAGE_EOL_WARNING_DAYS=30
CSAGE_ACCESS_KEY_MAX_AGE_DAYS=90
CSAGE_KMS_MAX_AGE_DAYS=365
CSAGE_ALLOWED_EMAIL_DOMAIN=icicibank.com
CSAGE_SENSITIVE_PORTS=22,3389,1433,1521,3306,5432,6379,9200,27017
CSAGE_BACKUP_MAX_AGE_HOURS=24
CSAGE_BACKUP_MIN_RETENTION_DAYS=7
CSAGE_DEPRECATED_LAMBDA_RUNTIMES=python3.7,python3.8,nodejs14.x,nodejs16.x

GUNICORN_WORKERS=3
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=300
